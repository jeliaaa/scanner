# Where the Python vision service listens. Point this at another machine if you
# run the CV service on your remote desktop and the UI locally.
PY_API_URL=http://127.0.0.1:8000

# Set when the frontend is hosted somewhere other than the backend (e.g. Vercel)
# so the browser calls the vision service directly instead of via the rewrite.
# Read at BUILD time.
# NEXT_PUBLIC_API_BASE=https://scan-api.example.com

# Portal hand-off allowlist: comma-separated origins that a ?upload_to= link is
# allowed to name. Anything else is refused, because that parameter is
# attacker-controllable and the payload is a scanned document. Read at BUILD
# time; empty means hand-off is disabled entirely.
# NEXT_PUBLIC_UPLOAD_ORIGINS=https://app.tarjimnebi.ge
