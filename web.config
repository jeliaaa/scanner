<?xml version="1.0" encoding="utf-8"?>
<!--
  Hosts the Next.js frontend under IIS via HttpPlatformHandler.

  IIS starts `next start` as a child process on a port it assigns, and
  reverse-proxies to it. Every request is forwarded to Node, so IIS never
  serves files out of this directory directly - Next.js handles its own static
  assets under /_next.

  Point an IIS site at the repository root as its physical path. The backend
  has a separate config in server/web.config. Prerequisites, application pool
  settings and permissions are documented in the project README.

  Requires `npm run build` to have been run first: `next start` will not boot
  without a production build, and the /api/py/* rewrite is baked in at build
  time.
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!--
      processPath must be the absolute path to node.exe. The value below is the
      default install location; confirm yours with `where node` and edit if it
      differs.
    -->
    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments=".\node_modules\next\dist\bin\next start --hostname 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\web-iis.log"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:05:00"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <!-- Next.js already compresses its own responses. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />

    <security>
      <requestFiltering>
        <!--
          Captured photos travel through here on their way to the backend via
          the /api/py/* rewrite, so this site needs the same 40 MB ceiling as
          server/web.config. IIS defaults to 30 MB and would reject a large
          photo with a 404.13 before Next.js ever saw it.
        -->
        <requestLimits maxAllowedContentLength="41943040" />
        <hiddenSegments>
          <!-- Belt and braces: the repository root is the site root, so make
               sure these can never be served even if the handler is changed. -->
          <add segment=".git" />
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
