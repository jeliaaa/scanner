<?xml version="1.0" encoding="utf-8"?>
<!--
  Hosts the FastAPI vision service under IIS via HttpPlatformHandler.

  IIS cannot run an ASGI app itself. HttpPlatformHandler starts uvicorn as a
  child process, picks a free port, passes it in as %HTTP_PLATFORM_PORT%, and
  reverse-proxies requests to it. IIS owns the process lifecycle, so this is an
  alternative to running the service under PM2 - do not do both, or the two
  copies will fight over the port.

  Point an IIS site or application at this directory (server/) as its physical
  path. Prerequisites and permissions are documented in the project README.
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- Remove any inherited Python/CGI handlers before claiming every verb. -->
      <clear />
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!--
      processPath is resolved relative to this directory, so the virtualenv is
      found without hard-coding where the repository was cloned.
      startupTimeLimit is generous because the first import of OpenCV and numpy
      is slow on a cold filesystem.
    -->
    <httpPlatform processPath=".\.venv\Scripts\python.exe"
                  arguments="-m uvicorn main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\cv-iis.log"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:05:00"
                  processesPerApplication="1">
      <environmentVariables>
        <!-- Unbuffered, or stdout never reaches the log file above. -->
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <!-- Scratch storage for in-progress scans. The application pool
             identity needs Modify on whatever this points at. -->
        <environmentVariable name="SCANNER_DATA_DIR" value=".\.data" />
        <!-- Uncomment when mounted as a virtual directory rather than its own
             site, so generated URLs keep the prefix.
        <environmentVariable name="ROOT_PATH" value="/api" />
        -->
      </environmentVariables>
    </httpPlatform>

    <!-- Exports stream a whole PDF back; IIS must not try to compress it. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />

    <security>
      <requestFiltering>
        <!--
          IIS rejects bodies over 30 MB by default, with a 404.13 raised before
          the request ever reaches the application. This matches the service's
          own MAX_UPLOAD_BYTES (40 MB) so a large photo gets the app's clear 413
          rather than an opaque IIS error page.
        -->
        <requestLimits maxAllowedContentLength="41943040" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
